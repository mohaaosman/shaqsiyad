{
  "info": {
    "name": "Shaqsiyad API",
    "description": "Fictional people with whole personalities: faces, ethnicity, faith, careers, tastes and connections. Read-only, no keys, CORS open. Every person is fictional; contact details use reserved domains and fictional phone ranges. 120 requests a minute per IP.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://shaqsiyad.example/api/v1"
    }
  ],
  "item": [
    {
      "name": "Search and filter people",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/personas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "personas"
          ],
          "query": [
            {
              "key": "q",
              "value": "",
              "description": "Free text. Names first, then places, work, traits, taste and story. Common spellings match (Mohamed, Muhammad).",
              "disabled": true
            },
            {
              "key": "gender",
              "value": "",
              "description": "male or female",
              "disabled": true
            },
            {
              "key": "minAge",
              "value": "",
              "description": "20–75",
              "disabled": true
            },
            {
              "key": "maxAge",
              "value": "",
              "description": "20–75",
              "disabled": true
            },
            {
              "key": "continent",
              "value": "",
              "description": "Africa, Asia, Europe, North America, South America, Oceania",
              "disabled": true
            },
            {
              "key": "country",
              "value": "",
              "description": "Country they live in, e.g. Kenya",
              "disabled": true
            },
            {
              "key": "ethnicity",
              "value": "",
              "description": "Ethnic group, e.g. Somali, Yoruba, Malaysian Chinese",
              "disabled": true
            },
            {
              "key": "religion",
              "value": "",
              "description": "Muslim, Catholic, Christian, Hindu, Buddhist, Not religious…",
              "disabled": true
            },
            {
              "key": "tier",
              "value": "",
              "description": "radiant, luminous, warm, soft, muted. Repeat or comma-separate.",
              "disabled": true
            },
            {
              "key": "mbti",
              "value": "",
              "description": "e.g. INFJ",
              "disabled": true
            },
            {
              "key": "relationship",
              "value": "",
              "description": "Single, Dating, Engaged, Married, Divorced, Widowed, Separated",
              "disabled": true
            },
            {
              "key": "industry",
              "value": "",
              "description": "e.g. Software, Healthcare",
              "disabled": true
            },
            {
              "key": "status",
              "value": "",
              "description": "Employed, Self-employed, Studying, Retired, Between jobs",
              "disabled": true
            },
            {
              "key": "sort",
              "value": "",
              "description": "relevance, name, age, age_desc, score, connected, shuffle",
              "disabled": true
            },
            {
              "key": "page",
              "value": "",
              "description": "From 1",
              "disabled": true
            },
            {
              "key": "limit",
              "value": "",
              "description": "1–100",
              "disabled": true
            },
            {
              "key": "full",
              "value": "",
              "description": "1 = complete people instead of summaries",
              "disabled": true
            },
            {
              "key": "format",
              "value": "",
              "description": "json (default), csv or ndjson. CSV and NDJSON carry summaries.",
              "disabled": true
            }
          ],
          "variable": []
        }
      }
    },
