            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Country they live in, e.g. Kenya",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ethnicity",
            "in": "query",
            "description": "Ethnic group, e.g. Somali, Yoruba, Malaysian Chinese",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "religion",
            "in": "query",
            "description": "Muslim, Catholic, Christian, Hindu, Buddhist, Not religious…",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tier",
            "in": "query",
            "description": "radiant, luminous, warm, soft, muted. Repeat or comma-separate.",
