{
  "openapi": "3.1.0",
  "info": {
    "title": "Shaqsiyad API",
    "version": "1.0.0",
    "description": "Fictional people with whole personalities: faces, ethnicity, faith, careers, tastes and connections. Read-only, no keys, CORS open. Every person is fictional; contact details use reserved domains and fictional phone ranges. 120 requests a minute per IP.",
    "license": {
      "name": "API terms: free for demos, tests and prototypes",
      "url": "https://github.com/mohaaosman/shaqsiyad"
    }
  },
  "servers": [
    {
      "url": "https://shaqsiyad.example/api/v1"
    }
  ],
  "externalDocs": {
    "url": "https://github.com/mohaaosman/shaqsiyad"
  },
  "paths": {
    "/personas": {
      "get": {
        "operationId": "search",
        "summary": "Search and filter people",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Free text. Names first, then places, work, traits, taste and story. Common spellings match (Mohamed, Muhammad).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "gender",
            "in": "query",
            "description": "male or female",
            "schema": {
              "type": "string",
              "enum": [
                "male",
                "female"
              ]
            }
          },
          {
            "name": "minAge",
            "in": "query",
            "description": "20–75",
            "schema": {
              "type": "integer",
              "minimum": 20,
              "maximum": 75
            }
          },
          {
            "name": "maxAge",
            "in": "query",
            "description": "20–75",
            "schema": {
              "type": "integer",
              "minimum": 20,
              "maximum": 75
            }
          },
          {
            "name": "continent",
            "in": "query",
            "description": "Africa, Asia, Europe, North America, South America, Oceania",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "description": "Country they live in, e.g. Kenya",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ethnicity",
            "in": "query",
            "description": "Ethnic group, e.g. Somali, Yoruba, Malaysian Chinese",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "religion",
            "in": "query",
            "description": "Muslim, Catholic, Christian, Hindu, Buddhist, Not religious…",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tier",
            "in": "query",
            "description": "radiant, luminous, warm, soft, muted. Repeat or comma-separate.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mbti",
            "in": "query",
            "description": "e.g. INFJ",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "relationship",
            "in": "query",
            "description": "Single, Dating, Engaged, Married, Divorced, Widowed, Separated",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "industry",
            "in": "query",
            "description": "e.g. Software, Healthcare",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Employed, Self-employed, Studying, Retired, Between jobs",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "relevance, name, age, age_desc, score, connected, shuffle",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "From 1",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1–100",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "full",
            "in": "query",
            "description": "1 = complete people instead of summaries",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "format",
            "in": "query",
            "description": "json (default), csv or ndjson. CSV and NDJSON carry summaries.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv",
                "ndjson"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad or unknown parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "More than 120 requests a minute from one IP",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
